{
  "name": "@proofline/api",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --enable-source-maps dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:push": "prisma db push --config prisma.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:check": "tsx src/database/db-check.ts",
    "runtime:check": "pnpm build && node --enable-source-maps dist/runtime-check.js && node --enable-source-maps dist/control-runtime-check.js",
    "auth:bootstrap-local": "tsx prisma/bootstrap-auth.ts",
    "dev:control": "node --enable-source-maps dist/main-control.js",
    "demo:support-fixtures": "tsx prisma/demo-support-fixtures.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-fastify": "11.2.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "dotenv": "17.2.1",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.15.5",
    "prisma": "7.9.1",
    "tsx": "4.20.5",
    "typescript": "6.0.3"
  }
}
