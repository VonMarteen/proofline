{
  "name": "proofline",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.19 <25"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "infra:up": "node scripts/armar-preflight.mjs --infra && docker compose -p armar-proofline -f docker-compose.dev.yml up -d --build --wait --remove-orphans",
    "infra:down": "docker compose -p armar-proofline -f docker-compose.dev.yml down",
    "infra:reset": "node scripts/refuse-destructive-reset.mjs",
    "infra:logs": "docker compose -p armar-proofline -f docker-compose.dev.yml logs -f --tail=120",
    "db:generate": "pnpm --filter @proofline/api db:generate",
    "db:push": "pnpm --filter @proofline/api db:push",
    "db:seed": "pnpm --filter @proofline/api db:seed",
    "db:setup": "pnpm db:generate && pnpm db:push && pnpm db:seed",
    "dev": "node scripts/dev-all.mjs",
    "dev:site": "pnpm --filter @proofline/site dev",
    "dev:web": "pnpm --filter @proofline/web dev",
    "dev:respond": "pnpm --filter @proofline/respond dev",
    "dev:control": "pnpm --filter @proofline/control dev",
    "dev:api": "pnpm --filter @proofline/api build && pnpm --filter @proofline/api dev",
    "dev:worker": "pnpm --filter @proofline/worker dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "audit:static": "node scripts/static-audit.mjs",
    "stop": "node scripts/stop-local.mjs",
    "quality:local": "pnpm audit:static && pnpm typecheck && pnpm build",
    "db:check": "pnpm --filter @proofline/api db:check",
    "runtime:check": "pnpm --filter @proofline/api runtime:check",
    "auth:bootstrap-local": "pnpm --filter @proofline/api auth:bootstrap-local",
    "dev:control-api": "pnpm --filter @proofline/api dev:control",
    "demo:support-fixtures": "pnpm --filter @proofline/api demo:support-fixtures",
    "dev:support": "pnpm --filter @proofline/support dev",
    "demo:functional-fixtures": "pnpm --filter @proofline/api demo:functional-fixtures",
    "preflight": "node scripts/armar-preflight.mjs",
    "infra:audit": "node scripts/armar-infra-audit.mjs",
    "infra:legacy:stop": "node scripts/stop-legacy-proofline-infra.mjs",
    "infra:env:normalize": "node scripts/normalize-local-env.mjs",
    "services:check": "node scripts/check-services.mjs",
    "pilot:check": "pnpm --filter @proofline/api pilot:check",
    "email:check": "pnpm --filter @proofline/worker email:check",
    "control:p2:check": "pnpm --filter @proofline/api exec tsx --test ../../tests/control-p2-pagination.test.mjs ../../tests/control-p2-contract.test.mjs",
    "control:p3:check": "node --test tests/control-p3-dashboard.test.mjs",
    "control:p4:check": "pnpm --filter @proofline/api exec tsx --test ../../tests/control-p4-operations.test.mjs",
    "site:qa": "node scripts/site-commercial-qa.mjs",
    "control:p5:check": "pnpm --filter @proofline/api exec tsx --test ../../tests/control-p5-workflows.test.mjs",
    "control:p6:check": "pnpm --filter @proofline/api exec tsx --test ../../tests/control-p6-commercial.test.mjs",
    "control:p7:check": "pnpm --filter @proofline/api exec tsx --test ../../tests/control-p7-governance.test.mjs",
    "control:visual:check": "node --test tests/control-visual-audit-20261019.test.mjs",
    "control:ui01:check": "pnpm --filter @proofline/api exec tsx --test ../../tests/control-ui01-density-records.test.mjs",
    "control:uxa2:check": "node --test tests/control-uxa2-performance.test.mjs",
    "control:uxa3:check": "node --test tests/control-uxa3-server-lists.test.mjs tests/control-uxa3-behavior.test.mjs",
    "control:uxa4:check": "node --test tests/control-uxa4-visual-functions.test.mjs",
    "control:cqf1:check": "node --test tests/control-cqf1-20261020.test.mjs",
    "control:cqf-f1:check": "node --test tests/control-cqf-functional-1.test.mjs",
    "control:cqf-f2:check": "node --test tests/control-cqf-functional-2.test.mjs tests/control-cqf-functional-1.test.mjs",
    "control:cqf-f3:check": "node --test tests/control-cqf-functional-3.test.mjs",
    "control:cqf-f4:check": "pnpm --filter @proofline/api exec tsx --test ../../tests/control-cqf-functional-4.test.mjs",
    "workspace:ws1:check": "node --test tests/workspace-ws1-security-integrity.test.mjs",
    "workspace:ws2:check": "node --test tests/workspace-ws2-creation-lifecycle.test.mjs",
    "workspace:ws3:check": "node --test tests/workspace-ws3-report-visual-contract.test.mjs",
    "workspace:ws3:distribution:check": "node --test tests/workspace-ws3-distribution-integrity.test.mjs",
    "workspace:ws5:check": "node --test tests/workspace-ws5-operational-quality.test.mjs",
    "workspace:ws5:smoke": "node scripts/workspace-ws5-readonly-smoke.mjs",
    "workspace:ws5:visual:check": "node --test tests/workspace-ws5-visual-final-20261022.test.mjs",
    "workspace:ws5:gate:check": "node --test tests/workspace-ws5-gate-integrity-20261022.test.mjs",
    "workspace:ws5:gate": "node scripts/workspace-ws5-gate.mjs",
    "workspace:ws5:gate:full": "node scripts/workspace-ws5-gate.mjs --full",
    "proofline:g0": "node scripts/proofline-g0.mjs --capture",
    "proofline:g0:db": "node scripts/proofline-g0-db.mjs --confirm-local-database",
    "proofline:g1": "node scripts/proofline-g1.mjs",
    "proofline:g1:db:read": "node scripts/proofline-g1-db-readonly.mjs",
    "proofline:g0g1:check": "node --test tests/proofline-g0-g1-baseline-integrity.test.mjs",
    "proofline:g1:faultlab": "node scripts/proofline-g1-faultlab.mjs",
    "proofline:g0g1:export": "node scripts/proofline-g0-g1-export.mjs"
  },
  "devDependencies": {
    "turbo": "2.10.10",
    "typescript": "6.0.3"
  }
}
