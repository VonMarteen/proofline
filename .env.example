# PROOFLINE production-oriented environment example.
# Local development receives safe defaults from apps/api/src/local-env.ts.
NODE_ENV=development
AUTH_MODE=dev
AUTH_OTP_PEPPER=change-me-in-production
# Armar Technologies local infrastructure registry — PROOFLINE 4200–4299
SITE_APP_URL=http://localhost:4200
CLIENT_APP_URL=http://localhost:4202
RESPOND_APP_URL=http://localhost:4203
CONTROL_APP_URL=http://localhost:4204
SUPPORT_APP_URL=http://localhost:4205
NEXT_PUBLIC_SUPPORT_APP_URL=http://localhost:4205
NEXT_PUBLIC_API_URL=http://localhost:4201
API_INTERNAL_URL=http://127.0.0.1:4201
CONTROL_API_INTERNAL_URL=http://127.0.0.1:4206
CONTROL_API_PORT=4206
ANALYTICS_URL=http://127.0.0.1:4281
SMTP_HOST=127.0.0.1
SMTP_PORT=4225
PROOFLINE_DATABASE_URL=postgresql://proofline:proofline_local_only@127.0.0.1:4232/proofline?schema=public
CORS_ORIGINS=http://localhost:4200,http://localhost:4202,http://localhost:4203,http://127.0.0.1:4200,http://127.0.0.1:4202,http://127.0.0.1:4203
CONTROL_CORS_ORIGINS=http://localhost:4204,http://localhost:4205,http://127.0.0.1:4204,http://127.0.0.1:4205
# MinIO is optional (profile "files") but its host ports are reserved in this block.
S3_ENDPOINT=http://127.0.0.1:4290
MINIO_CONSOLE_URL=http://localhost:4291

SERVICE_TOKEN=proofline-local-service-token
DEV_BLIND_INDEX_KEY=proofline-local-blind-index-key
DEV_ENCRYPTION_KEY_B64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# In production, use a separate least-privilege DB credential for the privileged Control API.
# CONTROL_DATABASE_URL=postgresql://proofline_control:change-me@db:5432/proofline?schema=public

# Payment provider adapters. Never place real secrets in source control.
# REDSYS_MERCHANT_CODE=
# REDSYS_TERMINAL=
# REDSYS_SECRET_KEY=
# REDSYS_MERCHANT_URL=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PROOFLINE_BANK_ACCOUNT_HOLDER=
# PROOFLINE_BANK_IBAN=
# PROOFLINE_BANK_BIC=
